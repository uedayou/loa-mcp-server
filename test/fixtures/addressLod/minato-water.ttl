    schem:additionalProperty
        [ a schem:PropertyValue; schem:propertyID "loa:jinko"; schem:name "人口（参考値）"@ja; schem:value 260486; schem:description "この市区町村内の2020年国勢調査における基本単位区（計3683個）の人口を合算した参考値。水面調査区等（町丁目に属さない）の人口5人を含むため、配下の町丁目の合計とは一致しない。公式統計値ではない。"@ja ],
        [ a schem:PropertyValue; schem:propertyID "loa:setai"; schem:name "世帯数（参考値）"@ja; schem:value 146160; schem:description "この市区町村内の2020年国勢調査における基本単位区（計3683個）の世帯数を合算した参考値。水面調査区等（町丁目に属さない）の世帯数5世帯を含むため、配下の町丁目の合計とは一致しない。公式統計値ではない。"@ja ],
        [ a schem:PropertyValue; schem:propertyID "loa:kbsum"; schem:name "合算基本単位区数（参考値）"@ja; schem:value 3683; schem:description "この人口・世帯数の参考値が2020年国勢調査の何個の基本単位区を合算したものかを示す（推計の粒度の目安）。"@ja ];
